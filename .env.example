# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000

# Database
MONGO_URI=mongodb://127.0.0.1:27017/auth_service

# JWT
JWT_ACCESS_SECRET=replace_with_long_random_access_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_long_random_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d

# Cookies
COOKIE_DOMAIN=localhost
ACCESS_TOKEN_COOKIE=accessToken
REFRESH_TOKEN_COOKIE=refreshToken

# Email verification / reset tokens
EMAIL_VERIFICATION_EXPIRES_MIN=60
PASSWORD_RESET_EXPIRES_MIN=30
OTP_EXPIRES_MIN=5
OTP_MAX_ATTEMPTS=5

# Account locking
MAX_LOGIN_ATTEMPTS=5
LOCK_TIME_MIN=30

# Nodemailer (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_pass
EMAIL_FROM="Auth Service <no-reply@example.com>"
